{
	"name": "99.css",
	"version": "0.3.1",
	"description": "Modular, scalable 98.css: a design system for building faithful recreations of old UIs",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dragunovartem99/99.css.git"
	},
	"homepage": "https://dragunovartem99.github.io/99.css/",
	"keywords": [
		"css",
		"windows98"
	],
	"files": [
		"src"
	],
	"exports": {
		".": "./src/index.css",
		"./*.css": "./src/*.css",
		"./icon/*": "./src/icon/*",
		"./fonts/*": "./src/fonts/*"
	},
	"style": "./src/index.css",
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"dev": "vite docs",
		"build": "vite build docs --base ./ --outDir ../dist --emptyOutDir",
		"preview": "vite preview docs --outDir ../dist"
	},
	"devDependencies": {
		"vite": "^8.0.1"
	}
}
